# ==================== 后端运行阶段 ====================
FROM node:20-alpine

WORKDIR /app

# 安装依赖
COPY server/package.json server/package-lock.json* ./
RUN npm ci --prefer-offline || npm install --production

# 复制源代码
COPY server/ ./

# 创建数据持久化目录
RUN mkdir -p /app/data

# 暴露端口
EXPOSE 3001

# 环境变量
ENV NODE_ENV=production
ENV PORT=3001

# 启动后端
CMD ["npx", "tsx", "server.ts"]
